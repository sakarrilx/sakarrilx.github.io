---
import Icon from './Icon.astro';

interface Props {
  icon?: 'book' | 'calendar' | 'layers' | 'paper';
  title: string;
  description: string;
}

const { icon = 'paper', title, description } = Astro.props;
---

<div class="empty-state">
  <span class="empty-icon"><Icon name={icon} size={23} /></span>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</div>
