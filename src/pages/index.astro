---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import EmptyState from '../components/EmptyState.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{site.role} · {site.university}</p>
      <h1>
        Building systems.<br />
        <span>Understanding intelligence.</span>
      </h1>
      <p class="hero-lede">
        I’m {site.name}, a student of computer science exploring intelligent storage systems and efficient model inference.
      </p>
      <blockquote>“{site.tagline}”</blockquote>
      <div class="hero-actions">
        <a class="button button-primary" href="/log/">
          Explore my research log
          <Icon name="arrow" size={17} />
        </a>
        <a class="button button-secondary" href="/about/">More about me</a>
      </div>
    </div>

    <aside class="profile-card" aria-label="Academic profile summary">
      <div class="profile-top">
        <div class="avatar" aria-hidden="true">S</div>
        <div>
          <p class="profile-name">{site.name}</p>
          <p class="profile-handle">@{site.github}</p>
        </div>
      </div>
      <dl class="profile-details">
        <div>
          <dt>Status</dt>
          <dd><span class="status-dot"></span>Preparing for graduate study</dd>
        </div>
        <div>
          <dt>Program</dt>
          <dd>{site.program}</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Intelligent Storage · Model Inference</dd>
        </div>
        <div>
          <dt>Based at</dt>
          <dd>{site.university}</dd>
        </div>
      </dl>
      <a class="profile-link" href={`https://github.com/${site.github}`} target="_blank" rel="noreferrer">
        <Icon name="github" size={17} />
        github.com/{site.github}
        <Icon name="external" size={14} />
      </a>
      <a class="profile-link" href={`mailto:${site.email}`}>
        <Icon name="mail" size={17} />
        {site.email}
        <Icon name="external" size={14} />
      </a>
    </aside>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research interests</p>
        <h2>Questions worth pursuing</h2>
      </div>
      <p>My current interests sit at the intersection of systems efficiency and modern AI workloads.</p>
    </div>
    <div class="focus-grid">
      <article class="focus-card">
        <span class="card-icon"><Icon name="layers" /></span>
        <span class="card-index">01</span>
        <h3>Intelligent Storage</h3>
        <p>Exploring storage systems that can adapt, optimize, and make better decisions for data-intensive workloads.</p>
        <a href="/projects/">See research direction <Icon name="arrow" size={15} /></a>
      </article>
      <article class="focus-card">
        <span class="card-icon"><Icon name="spark" /></span>
        <span class="card-index">02</span>
        <h3>Model Inference</h3>
        <p>Studying practical ways to make model inference faster, more efficient, and easier to deploy.</p>
        <a href="/projects/">See research direction <Icon name="arrow" size={15} /></a>
      </article>
    </div>
  </section>

  <section class="section section-rule shell">
    <div class="section-heading compact">
      <div>
        <p class="eyebrow">Latest activity</p>
        <h2>Research, documented as it happens</h2>
      </div>
      <a class="text-link" href="/log/">View all entries <Icon name="arrow" size={15} /></a>
    </div>
    <EmptyState
      icon="calendar"
      title="The first research log is on its way"
      description="Future entries will capture weekly progress, experiments, obstacles, and next steps."
    />
  </section>

  <section class="section shell">
    <div class="now-card">
      <div class="now-marker">
        <span>NOW</span>
        <span class="now-line"></span>
      </div>
      <div class="now-copy">
        <p class="eyebrow">Current chapter</p>
        <h2>Preparing with intention.</h2>
        <p>
          I am laying the foundation for graduate research: strengthening core knowledge, exploring promising questions,
          and building a habit of writing down what I learn.
        </p>
      </div>
      <div class="now-links">
        <a href="/notes/"><Icon name="book" size={18} />Browse notes</a>
        <a href="/about/"><Icon name="user" size={18} />Read my profile</a>
      </div>
    </div>
  </section>
</BaseLayout>
